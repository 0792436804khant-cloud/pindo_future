# ==============================================================================
# PINDO FUTURE — Production Railway Environment Variables Template
# ==============================================================================
# In your Railway Dashboard:
# 1. Create a PostgreSQL service (Postgres plugin).
# 2. Create a Redis service (Redis plugin).
# 3. Create a LiveKit Server service or connect LiveKit Cloud credentials.
# 4. Attach these variables to your Pindo Future Backend service.
# ==============================================================================

APP_NAME="Pindo Future"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- PostgreSQL Database (Railway Managed) ---
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Redis Cache & Queue (Railway Managed) ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# --- LiveKit WebRTC SFU Streaming Cluster ---
LIVEKIT_URL=wss://${{LiveKit.RAILWAY_PUBLIC_DOMAIN}}
LIVEKIT_API_KEY=devkey_pindo_future
LIVEKIT_API_SECRET=secret_pindo_future_webrtc_cluster_key_123
LIVEKIT_TOKEN_TTL=21600

# --- S3 / Cloudflare R2 / DigitalOcean Spaces (Protected Recordings & PDFs) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_R2_OR_S3_KEY
AWS_SECRET_ACCESS_KEY=YOUR_R2_OR_S3_SECRET
AWS_DEFAULT_REGION=auto
AWS_BUCKET=pindo-future-vault
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# --- Algerian Academic Payment Gateway (Edahabia / CIB SATIM) ---
SATIM_MERCHANT_ID=
SATIM_TERMINAL_ID=
SATIM_SECRET_KEY=
SATIM_WEBHOOK_SECRET=
